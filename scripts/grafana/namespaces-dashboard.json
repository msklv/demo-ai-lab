        "datasource": {
          "type": "prometheus",
          "uid": "__PROM_UID__"
        },
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
