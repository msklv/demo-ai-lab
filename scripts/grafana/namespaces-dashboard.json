            "expr": "histogram_quantile(0.9, sum by (le, namespace) (label_replace(rate(envoy_cluster_upstream_rq_time_bucket{cluster_name=~\"outbound[|][0-9]+[|][|][^.]+[.]($namespace)[.]svc[.]cluster[.]local\"}[5m]), \"namespace\", \"$1\", \"cluster_name\", \"outbound[|][0-9]+[|][|][^.]+[.]([^.]+)[.]svc[.]cluster[.]local\"))) > 0",
            "legendFormat": "{{namespace}}",
            "refId": "A",
            "instant": false,
            "range": true,
            "format": "time_series"
          }
        ]
      },
      {
        "type": "table",
        "title": "ТОП сервисов сейчас, req/s",
        "datasource": {
          "type": "prometheus",
          "uid": "__PROM_UID__"
        },
        "description": "Мгновенный срез по всем сервисам за шлюзом (включая GPUStack-модели): сколько запросов в секунду уходит в каждый бэкенд",
