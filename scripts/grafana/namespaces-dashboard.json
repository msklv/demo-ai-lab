            "legendFormat": "{{service}}",
            "refId": "A",
            "instant": true,
            "range": false,
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "Field": true
              },
              "renameByName": {
                "service": "Сервис",
                "Value": "req/s"
              }
            }
          }
        ]
