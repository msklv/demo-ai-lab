              "lineWidth": 1,
              "fillOpacity": 8,
              "showPoints": "never",
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
