    },
    "templating": {
      "list": [
        {
          "name": "namespace",
          "label": "Неймспейс",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "definition": "label_values(container_memory_working_set_bytes{container!=\"\"}, namespace)",
          "query": {
            "query": "label_values(container_memory_working_set_bytes{container!=\"\"}, namespace)",
            "refId": "namespace"
          },
          "refresh": 2,
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "current": {
            "selected": true,
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "sort": 1,
          "hide": 0,
          "regex": ""
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "type": "timeseries",
        "title": "Запросы к сервисам (upstream), req/s",
        "description": "Сколько запросов Higress отправил в сервисы неймспейса. Неймспейс берётся из имени кластера envoy: outbound|<port>||<svc>.<ns>.svc.cluster.local",
        "datasource": {
          "type": "prometheus",
          "uid": "__PROM_UID__"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 8,
              "showPoints": "never",
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "__PROM_UID__"
            },
            "expr": "sum by (namespace) (label_replace(rate(envoy_cluster_upstream_rq_total{cluster_name=~\"outbound[|][0-9]+[|][|][^.]+[.]($namespace)[.]svc[.]cluster[.]local\"}[5m]), \"namespace\", \"$1\", \"cluster_name\", \"outbound[|][0-9]+[|][|][^.]+[.]([^.]+)[.]svc[.]cluster[.]local\"))",
            "legendFormat": "{{namespace}}",
            "refId": "A",
            "instant": false,
            "range": true,
            "format": "time_series"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Доля ответов 5xx, %",
        "description": "Отношение 5xx-ответов бэкендов к общему числу запросов в этот неймспейс",
        "datasource": {
          "type": "prometheus",
          "uid": "__PROM_UID__"
        },
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 8,
              "showPoints": "never",
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "__PROM_UID__"
            },
            "expr": "sum by (namespace) (label_replace(rate(envoy_cluster_upstream_rq{response_code_class=\"5xx\", cluster_name=~\"outbound[|][0-9]+[|][|][^.]+[.]($namespace)[.]svc[.]cluster[.]local\"}[5m]), \"namespace\", \"$1\", \"cluster_name\", \"outbound[|][0-9]+[|][|][^.]+[.]([^.]+)[.]svc[.]cluster[.]local\")) / sum by (namespace) (label_replace(rate(envoy_cluster_upstream_rq_total{cluster_name=~\"outbound[|][0-9]+[|][|][^.]+[.]($namespace)[.]svc[.]cluster[.]local\"}[5m]), \"namespace\", \"$1\", \"cluster_name\", \"outbound[|][0-9]+[|][|][^.]+[.]([^.]+)[.]svc[.]cluster[.]local\"))",
            "legendFormat": "{{namespace}}",
            "refId": "A",
            "instant": false,
            "range": true,
            "format": "time_series"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "p90 upstream-задержка, ms",
